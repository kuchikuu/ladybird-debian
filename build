#!/usr/bin/env bash
set -euo pipefail

# Keep Ladybird's Rust toolchain and Cargo files inside the repository.
LOCAL_RUST=false

patch_vcpkg_for_debian() {
    local file="vcpkg.json"

    jq -e '.dependencies[] | select(type == "object" and .name == "qtbase") | .platform | contains("linux")' "$file" >/dev/null && return

    echo "Patching vcpkg.json for Debian..."

    local tmp
    tmp="$(mktemp)"

    if jq '
        (.overrides[] | select(.name == "qtpositioning") | .version) as $qt_version |
        .dependencies |= map(
            if type == "object" and .name == "qtbase" then
                .platform = "linux | freebsd" |
                .features += ["egl"]
            elif type == "object" and .name == "qtpositioning" then
                .platform = "linux | windows | freebsd"
            else
                .
            end
        ) |
        .dependencies += [{
            "name": "qtwayland",
            "platform": "linux",
            "default-features": false
        }] |
        .overrides += [{
            "name": "qtwayland",
            "version": $qt_version
        }]
    ' "$file" > "$tmp"; then
        mv "$tmp" "$file"
    else
        rm -f "$tmp"
        return 1
    fi
}

if [[ -r /etc/os-release ]]; then
    source /etc/os-release

    if [[ "$ID" == "debian" ]]; then

	declare -A REQUIRED_PACKAGES=(
	    [autoconf]="Ladybird requires autoconf."
	    [autoconf-archive]="Ladybird requires autoconf-archive."
	    [automake]="Ladybird requires automake."
	    [build-essential]="Ladybird requires build-essential."
	    [ccache]="Ladybird requires ccache."
	    [cmake]="Ladybird requires CMake."
	    [curl]="Ladybird requires curl."
	    [fonts-liberation2]="Ladybird requires fonts-liberation2."
	    [git]="Ladybird requires git."
	    [glslang-tools]="Ladybird requires glslang-tools."
	    [libdrm-dev]="Ladybird requires libdrm-dev."
	    [libgl1-mesa-dev]="Ladybird requires libgl1-mesa-dev."
	    [libncurses-dev]="Ladybird requires libncurses-dev."
	    [libpulse-dev]="Ladybird requires libpulse-dev."
	    [libtool]="Ladybird requires libtool."
	    [nasm]="Ladybird requires nasm."
	    [ninja-build]="Ladybird requires ninja-build."
	    [pkg-config]="Ladybird requires pkg-config."
	    [python3-venv]="Ladybird requires python3-venv."
	    [tar]="Ladybird requires tar."
	    [unzip]="Ladybird requires unzip."
	    [zip]="Ladybird requires zip."

	    [jq]="This build script requires jq."
	    [libwayland-dev]="QtWayland requires libwayland-dev."
	    [mesa-common-dev]="ANGLE requires mesa-common-dev."
	)

	declare -A INSTALLED_PACKAGES

	while IFS=$'\t' read -r package status; do
	    [[ "$status" == "install ok installed" ]] && INSTALLED_PACKAGES["$package"]=1
	done < <(
	    dpkg-query -W -f='${Package}\t${Status}\n' \
		"${!REQUIRED_PACKAGES[@]}" 2>/dev/null
	)

	MISSING_PACKAGES=()

	for package in "${!REQUIRED_PACKAGES[@]}"; do
	    if [[ ! ${INSTALLED_PACKAGES[$package]+x} ]]; then
		echo "${REQUIRED_PACKAGES[$package]}"
		MISSING_PACKAGES+=("$package")
	    fi
	done

	if (( ${#MISSING_PACKAGES[@]} )); then
	    echo
	    echo "Install missing packages with:"
	    echo "sudo apt-get install ${MISSING_PACKAGES[*]}"
	    exit 1
	fi

        patch_vcpkg_for_debian
    fi
fi

if [[ "$LOCAL_RUST" == true ]]; then
    if [[ ! -x "$PWD/.cargo-home/bin/cargo" ]]; then
        echo "LOCAL_RUST is enabled, but no local Rust installation was found."
        echo "See the Local Rust section in README.md for installation instructions."
        exit 1
    fi

    if ! RUSTUP_HOME="$PWD/.rustup-home" \
    CARGO_HOME="$PWD/.cargo-home" \
    PATH="$PWD/.cargo-home/bin:$PATH" \
    ./Meta/ladybird.py run; then
        BUILD_FAILED=true
    fi
else
    if ! ./Meta/ladybird.py run; then
        BUILD_FAILED=true
    fi
fi

if [[ "${BUILD_FAILED:-false}" == true ]]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i dialog-error "Ladybird" "Compilation unsuccessful"
    fi
    exit 1
fi
